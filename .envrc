# ragged project environment configuration
# https://direnv.net/
#
# Automatically loads when entering this directory (requires direnv)
# Run `direnv allow` after cloning to enable

# Activate Python virtual environment
if [ -d ".venv" ]; then
    source .venv/bin/activate
else
    echo "Warning: .venv not found. Run 'python3.12 -m venv .venv && pip install -e .' first"
fi

# Development environment variables
export RAGGED_ENV=development
export RAGGED_LOG_LEVEL=DEBUG
export RAGGED_DATA_DIR=./data
export RAGGED_CHROMA_DIR=./chroma

# Python development settings
export PYTHONWARNINGS=default
export PYTEST_ADDOPTS="--verbose --color=yes"

# Disable Python bytecode (.pyc) files in development
export PYTHONDONTWRITEBYTECODE=1

# Helpful CLI shortcuts (optional - requires direnv v2.21.0+)
PATH_add .venv/bin

# Print activation message
echo "✓ ragged development environment activated"
echo "  Python: $(python --version 2>&1)"
echo "  ragged: $(ragged --version 2>&1 || echo 'not installed - run: pip install -e .')"
